# ─── Supabase (required) ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the browser (must not start with sb_publishable_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (optional, for local migration work / db:types)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_PASSWORD=your-database-password
# e.g. use db:push / db link against this project ref
SUPABASE_PROJECT_REF=your-project-ref

# ─── App settings ─────────────────────────────────────────────────────
# Where the app is deployed (used for OAuth redirects & Vercel cron URLs).
# Omit in local dev.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_DOMAIN=your-app.vercel.app

# Vercel Cron guard. Passed as `Authorization: Bearer` to the cron routes
# (/api/cron/ingest and /api/cron/settle).
CRON_SECRET=generate-a-long-random-string

# ─── Settlement ───────────────────────────────────────────────────────
# Once a position's delivery window has passed it is cashed out at its own
# instrument price: the position closes to flat, cash moves for that close, and
# a SETTLED trade records it. A delivered interval with no price is left open
# and reported ("awaiting price") rather than settled at a guess.
#   true  - (default) settle delivered positions automatically
#   false - leave them open until closed by hand
SETTLEMENT_ENABLED=true

# ─── ERCOT ingestion ──────────────────────────────────────────────────
# PowerFlow runs on ACTUAL ERCOT MIS data — MIS is public and needs no
# credentials or API keys.
#   ERCOT_MIS       - (default) ingest the live ERCOT MIS settlement reports
#                     (rolling 15-minute RT prices, the hourly RT settlement
#                     series, and the daily DAM clearing), with publication
#                     instants taken from ERCOT's own posting stamps.
#   ERCOT_REPLAY    - drive the same adapter over a HISTORICAL MIS corpus for
#                     replay trading (see scripts/ingest-history.ts and
#                     `npm run load:history`).
# There is no synthetic price feed: the simulator controls the clock and the
# trading; ERCOT provides the market.
ERCOT_SOURCE=ERCOT_MIS

# Max delivery-hour gap (hours) the simulation will produce.
# Reduced for Vercel free tier compatibility (10s function limit).
# A 24h window with small incremental updates is better than 72h batch.
INGEST_WINDOW_HOURS=24

# Max number of market_prices ingested per cron run (bounded serverless chunks).
# Reduced for Vercel free tier (500 records ~ 2-3s processing).
# Increase only if you upgrade to Vercel Pro (>10s limit).
INGEST_MAX_RECORDS=500
# Comma-separated product codes to ingest (e.g. RTM_HOURLY,DAM_HOURLY).
# Leave blank to ingest every product the configured source publishes.
INGEST_PRODUCTS=

# ─── Auth ─────────────────────────────────────────────────────────────
# Base URL of the app (OAuth redirects, links in confirmation emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in needs no variables here. The buttons on /login and /signup are
# read from the Supabase project itself (GET /auth/v1/settings), so enabling a
# provider is one action: Supabase → Authentication → Sign In / Providers →
# enable it, paste its client id and secret, and add
# https://<project-ref>.supabase.co/auth/v1/callback to that provider's
# authorized redirect URLs. Its button appears on the next page load.
#
# Supported: Google, GitHub, Microsoft, Apple, Discord, GitLab, LinkedIn, Slack,
# Facebook, Notion, Spotify, Twitch, X, Bitbucket, Figma, Kakao, Keycloak, Zoom.
# There is nothing to keep in sync in this file, and no client id or secret ever
# reaches the app — they stay in the Supabase dashboard.