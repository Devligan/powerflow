{
  "name": "powerflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "load:history": "tsx scripts/ingest-history.ts --fixture fixtures/ercot/replay-2026-09-20.json",
    "db:probe": "tsx scripts/db-probes.ts",
    "db:stale": "tsx scripts/db-clear-stale-runs.ts",
    "market:probe": "tsx scripts/market-probe-live.ts",
    "test": "vitest run",
    "test:db": "tsx scripts/test-db.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --project-id $PROJECT_REF > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.9",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "pg": "^8.23.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
